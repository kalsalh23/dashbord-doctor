{
  "name": "clinic-manager",
  "private": true,
  "version": "1.0.0",
  "description": "نظام إدارة العيادة — يعمل بلا إنترنت",
  "author": "م. قصي مهند الصالح",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:offline": "node scripts/test-offline.mjs",
    "export:data": "node scripts/export-offline.mjs",
    "seed:demo": "node scripts/make-dev-seed.mjs",
    "app": "npm run build && electron .",
    "app:dist": "npm run build && electron-builder --win portable -c.electronDist=node_modules/electron/dist"
  },
  "build": {
    "appId": "com.clinicmanager.offline",
    "productName": "ClinicManager",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.46.1",
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.454.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "three": "^0.186.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.10"
  }
}
